# Copy this file to `.env` for local development. Never commit `.env`.
# All values are read by backend/app/core/config.py via pydantic-settings.

# Application
APP_NAME=Horus
APP_ENV=dev
LOG_LEVEL=INFO

# Database (SQLite for M1 local dev; switch to PostgreSQL URL later, e.g. postgresql+psycopg2://user:pass@localhost:5432/horus)
DATABASE_URL=sqlite:///./horus.db
