# Copy this file to `backend/.env` for local development. Never commit `.env`.
# This file is always read from the backend directory, regardless of where
# you launch uvicorn from. Real environment variables take precedence.
#
# AI investigation (M6) — server-side only. Without these, AI features
# honestly report "unavailable" and everything else keeps working.

# Option A — local Ollama (free, no key). Install Ollama, run
# `ollama pull llama3.1:8b`, make sure it listens on :11434.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# AI_TIMEOUT=120
# AI_OLLAMA_URL=http://localhost:11434

# Option B — Google Gemini (needs an API key, never commit it).
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=
# AI_TIMEOUT=30

# Option C — Groq, OpenAI-compatible API (free tier; key from console.groq.com,
# never commit it). Fast open models, key travels in an Authorization header.
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-120b
# AI_GROQ_API_KEY=
# AI_TIMEOUT=60

# Option D — offline testing only (deterministic mock, no model calls).
# AI_PROVIDER=mock
